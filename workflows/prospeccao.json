{
  "name": "Prospecção B2B - Sem Site",
  "nodes": [
    {
      "parameters": {
        "path": "prospectar",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "prospectar"
    },
    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst cidade = String(q.cidade || '').trim();\nconst uf = String(q.uf || '').trim().toUpperCase();\nif (!cidade) throw new Error('Parâmetro \"cidade\" é obrigatório. Ex: ?cidade=Curitiba&uf=PR');\nif (uf && !/^[A-Z]{2}$/.test(uf)) throw new Error('Parâmetro \"uf\" deve ter 2 letras. Ex: PR');\nconst slug = s => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\\s+/g, '-');\nconst esc = s => s.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"');\nconst area = uf\n  ? `area[\"ISO3166-2\"=\"BR-${uf}\"]->.uf;rel[\"name\"=\"${esc(cidade)}\"][\"boundary\"=\"administrative\"](area.uf);map_to_area->.a;`\n  : `area[\"name\"=\"${esc(cidade)}\"][\"boundary\"=\"administrative\"]->.a;`;\nconst filtro = '[!\"website\"][!\"contact:website\"]';\nconst overpass = `[out:json][timeout:120];${area}(` +\n  `nwr[\"shop\"]${filtro}(area.a);` +\n  `nwr[\"amenity\"~\"^(restaurant|cafe|bar|fast_food|dentist|clinic|pharmacy|veterinary)$\"]${filtro}(area.a);` +\n  `nwr[\"craft\"]${filtro}(area.a);` +\n  `);out center tags;`;\nreturn [{ json: { cidade, uf, cache_key: `cache:busca:${slug(cidade)}${uf ? ':' + uf.toLowerCase() : ''}`, overpass } }];\n"
      },
      "name": "Parâmetros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UPSTASH_REDIS_REST_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.UPSTASH_REDIS_REST_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\"GET\", $json.cache_key]) }}",
        "options": {}
      },
      "name": "Redis GET Cache",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.result }}",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Fora do Cache?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://overpass-api.de/api/interpreter",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "data",
              "value": "={{ $('Parâmetros').first().json.overpass }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "name": "Overpass API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UPSTASH_REDIS_REST_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.UPSTASH_REDIS_REST_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\"SET\", $('Parâmetros').first().json.cache_key, $now.toISO(), \"EX\", 604800]) }}",
        "options": {}
      },
      "name": "Redis SET Cache (7 dias)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        60
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const { cidade } = $('Parâmetros').first().json;\nconst elements = $input.first().json.elements || [];\nconst vistos = new Set();\nconst leads = [];\nfor (const el of elements) {\n  const t = el.tags || {};\n  const fone = t.phone || t['contact:phone'] || t['contact:mobile'];\n  if (!t.name || !fone) continue;\n  const osmId = `${el.type}/${el.id}`;\n  if (vistos.has(osmId)) continue;\n  let num = String(fone).split(/[;,/]/)[0].replace(/\\D/g, '').replace(/^0+/, '');\n  if (num.startsWith('55') && num.length >= 12) num = num.slice(2);\n  if (num.length !== 10 && num.length !== 11) continue;\n  num = '55' + num;\n  const isMobile = num.length === 13 && num[4] === '9';\n  vistos.add(osmId);\n  leads.push({\n    osm_id: osmId,\n    nome: t.name.slice(0, 255),\n    categoria: t.shop || t.amenity || t.craft || null,\n    cidade,\n    telefone: num,\n    whatsapp_link: isMobile ? `https://wa.me/${num}` : null,\n    is_mobile: isMobile,\n    endereco: [t['addr:street'], t['addr:housenumber'], t['addr:suburb']].filter(Boolean).join(', ') || null\n  });\n}\nreturn leads.map(json => ({ json }));\n"
      },
      "name": "Filtrar e Formatar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UPSTASH_REDIS_REST_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.UPSTASH_REDIS_REST_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\"SMISMEMBER\", \"leads:processados\", ...$input.all().map(i => i.json.osm_id)]) }}",
        "options": {}
      },
      "name": "Redis SMISMEMBER",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        260
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const leads = $('Filtrar e Formatar').all();\nconst flags = $input.first().json.result || [];\nreturn leads.filter((_, i) => Number(flags[i]) !== 1);\n"
      },
      "name": "Remover Já Processados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads_sem_site (osm_id, nome, categoria, cidade, telefone, whatsapp_link, is_mobile, endereco) VALUES ($1, $2, $3, $4, $5, $6, $7, $8) ON CONFLICT (osm_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [$json.osm_id, $json.nome, $json.categoria, $json.cidade, $json.telefone, $json.whatsapp_link, $json.is_mobile, $json.endereco] }}"
        }
      },
      "name": "Postgres INSERT",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1760,
        260
      ],
      "credentials": {
        "postgres": {
          "name": "Neon Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.UPSTASH_REDIS_REST_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.UPSTASH_REDIS_REST_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\"SADD\", \"leads:processados\", ...$('Remover Já Processados').all().map(i => i.json.osm_id)]) }}",
        "options": {}
      },
      "name": "Redis SADD Processados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        260
      ],
      "executeOnce": true
    }
  ],
  "connections": {
