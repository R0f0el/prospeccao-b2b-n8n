# Banco do n8n (Neon PostgreSQL)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=ep-xxxx.sa-east-1.aws.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=neondb_owner
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SSL_ENABLED=true

# n8n
N8N_ENCRYPTION_KEY=
N8N_HOST=seu-app.onrender.com
WEBHOOK_URL=https://seu-app.onrender.com/

# Upstash Redis (aba "REST API" do banco no painel Upstash)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
